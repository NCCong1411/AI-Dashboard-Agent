# Required runtime environment. Copy this file to backend/.env.
APP_ENV=development

# Optional P1-T01 settings.
APP_NAME=AI Dashboard Agent API
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=dashboard_session
SESSION_TTL_SECONDS=28800

# P1-T02 database accounts. Use different PostgreSQL roles. Never commit values.
# Runtime may read/write app metadata but must not own schemas or have DDL rights.
RUNTIME_DATABASE_URL=
# Migration owns app/analytics schema changes and is never used by the API runtime.
# backup-db.ps1 rejects URL query/fragment options; set libpq options such as
# PGSSLMODE in the process environment when a backup requires them.
MIGRATION_DATABASE_URL=
# Set true only after scripts/backup-db.ps1 validates a fresh custom-format backup.
MIGRATION_BACKUP_VERIFIED=false

# P1-T03 login roles. Each login must be a member of exactly one NOLOGIN group
# role: analytics_reader_all, analytics_reader_ca, or analytics_reader_tx.
# There is deliberately no fallback scope and these principals must be distinct.
READER_ALL_DATABASE_URL=
READER_CA_DATABASE_URL=
READER_TX_DATABASE_URL=

# P1-T04 demo seed passwords (minimum 12 characters); never commit real values.
SEED_BUILDER_ALL_PASSWORD=
SEED_VIEWER_ALL_PASSWORD=
SEED_VIEWER_CA_PASSWORD=
SEED_BUILDER_TX_PASSWORD=

# No LLM key is required until the approved provider task.

