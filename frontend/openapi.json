{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Dashboard Agent API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "operationId": "login_api_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Logout",
        "operationId": "logout_api_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Me",
        "operationId": "me_api_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/catalog": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Get Catalog",
        "operationId": "get_catalog_api_catalog_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "description": "Report process health without requiring database or LLM credentials.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Api Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CatalogKPI": {
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "sales_value",
              "transaction_count",
              "average_sale_value",
              "sold_property_count"
            ],
            "title": "Id"
          },
          "label_vi": {
            "type": "string",
            "title": "Label Vi"
          },
          "description_vi": {
            "type": "string",
            "title": "Description Vi"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "grain": {
            "type": "string",
            "title": "Grain"
          },
          "date_field": {
            "type": "string",
            "title": "Date Field"
          },
          "dimensions": {
            "items": {
              "type": "string",
              "enum": [
                "day",
                "month",
                "quarter",
                "year",
                "state",
                "city",
                "property_type",
                "agent"
              ]
            },
            "type": "array",
            "title": "Dimensions"
          },
          "view": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "View"
          },
          "sql_expression": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sql Expression"
          },
          "source_columns": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Columns"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "label_vi",
          "description_vi",
          "unit",
          "grain",
          "date_field",
          "dimensions"
        ],
        "title": "CatalogKPI"
      },
      "CatalogResponse": {
        "properties": {
          "catalog_version": {
            "type": "string",
            "title": "Catalog Version"
          },
          "default_date_range": {
            "type": "string",
            "title": "Default Date Range"
          },
          "money_encoding": {
            "type": "string",
            "title": "Money Encoding"
          },
          "kpis": {
            "items": {
              "$ref": "#/components/schemas/CatalogKPI"
            },
            "type": "array",
            "title": "Kpis"
          },
          "dimension_fields": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "propertyNames": {
                  "enum": [
                    "day",
                    "month",
                    "quarter",
                    "year",
                    "state",
                    "city",
                    "property_type",
                    "agent"
                  ]
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dimension Fields"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "catalog_version",
          "default_date_range",
          "money_encoding",
          "kpis"
        ],
        "title": "CatalogResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest"
      },
      "UserResponse": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "scope_profile": {
            "type": "string",
            "title": "Scope Profile"
          }
        },
        "type": "object",
        "required": [
          "username",
          "role",
          "scope_profile"
        ],
        "title": "UserResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "AgentError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "default": false,
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "AgentError",
        "type": "object"
      },
      "AgentResponse": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "needs_clarification",
              "awaiting_approval",
              "completed",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "draft": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DashboardSpec"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AgentError"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "status",
          "message"
        ],
        "title": "AgentResponse",
        "type": "object"
      },
      "AnalysisPlan": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "1.0.0",
            "title": "Schema Version",
            "type": "string"
          },
          "catalog_version": {
            "const": "1.0.0-import-baseline",
            "title": "Catalog Version",
            "type": "string"
          },
          "kpis": {
            "items": {
              "enum": [
                "sales_value",
                "transaction_count",
                "average_sale_value",
                "sold_property_count"
              ],
              "type": "string"
            },
            "maxItems": 4,
            "minItems": 1,
            "title": "Kpis",
            "type": "array"
          },
          "dimensions": {
            "default": [],
            "items": {
              "enum": [
                "day",
                "month",
                "quarter",
                "year",
                "state",
                "city",
                "property_type",
                "agent"
              ],
              "type": "string"
            },
            "maxItems": 4,
            "title": "Dimensions",
            "type": "array"
          },
          "filters": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/FilterSpec"
            },
            "maxItems": 12,
            "title": "Filters",
            "type": "array"
          },
          "date_range": {
            "$ref": "#/components/schemas/DateRange"
          },
          "sort": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/SortSpec"
            },
            "maxItems": 4,
            "title": "Sort",
            "type": "array"
          },
          "limit": {
            "anyOf": [
              {
                "maximum": 1000,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Limit"
          }
        },
        "required": [
          "schema_version",
          "catalog_version",
          "kpis"
        ],
        "title": "AnalysisPlan",
        "type": "object"
      },
      "DashboardSpec": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "1.0.0",
            "title": "Schema Version",
            "type": "string"
          },
          "catalog_version": {
            "const": "1.0.0-import-baseline",
            "title": "Catalog Version",
            "type": "string"
          },
          "title": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "queries": {
            "items": {
              "$ref": "#/components/schemas/QuerySpec"
            },
            "maxItems": 6,
            "minItems": 1,
            "title": "Queries",
            "type": "array"
          },
          "widgets": {
            "items": {
              "$ref": "#/components/schemas/WidgetSpec"
            },
            "maxItems": 8,
            "minItems": 1,
            "title": "Widgets",
            "type": "array"
          }
        },
        "required": [
          "schema_version",
          "catalog_version",
          "title",
          "queries",
          "widgets"
        ],
        "title": "DashboardSpec",
        "type": "object"
      },
      "DateRange": {
        "additionalProperties": false,
        "properties": {
          "start": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Start"
          },
          "end_exclusive": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "End Exclusive"
          }
        },
        "title": "DateRange",
        "type": "object"
      },
      "FilterSpec": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "enum": [
              "state",
              "city",
              "property_type",
              "agent"
            ],
            "title": "Field",
            "type": "string"
          },
          "op": {
            "enum": [
              "eq",
              "in"
            ],
            "title": "Op",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "field",
          "op",
          "value"
        ],
        "title": "FilterSpec",
        "type": "object"
      },
      "QueryResult": {
        "additionalProperties": false,
        "properties": {
          "columns": {
            "items": {
              "$ref": "#/components/schemas/ResultColumn"
            },
            "title": "Columns",
            "type": "array"
          },
          "rows": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Rows",
            "type": "array"
          },
          "latency_ms": {
            "minimum": 0,
            "title": "Latency Ms",
            "type": "integer"
          },
          "status": {
            "enum": [
              "ok",
              "no_data",
              "error"
            ],
            "title": "Status",
            "type": "string"
          },
          "warnings": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "columns",
          "rows",
          "latency_ms",
          "status"
        ],
        "title": "QueryResult",
        "type": "object"
      },
      "QuerySpec": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "title": "Id",
            "type": "string"
          },
          "plan": {
            "$ref": "#/components/schemas/AnalysisPlan"
          }
        },
        "required": [
          "id",
          "plan"
        ],
        "title": "QuerySpec",
        "type": "object"
      },
      "ResultColumn": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "type": {
            "enum": [
              "string",
              "integer",
              "decimal",
              "date",
              "datetime"
            ],
            "title": "Type",
            "type": "string"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Unit"
          }
        },
        "required": [
          "name",
          "type"
        ],
        "title": "ResultColumn",
        "type": "object"
      },
      "SortSpec": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "anyOf": [
              {
                "enum": [
                  "sales_value",
                  "transaction_count",
                  "average_sale_value",
                  "sold_property_count"
                ],
                "type": "string"
              },
              {
                "enum": [
                  "day",
                  "month",
                  "quarter",
                  "year",
                  "state",
                  "city",
                  "property_type",
                  "agent"
                ],
                "type": "string"
              }
            ],
            "title": "Field"
          },
          "direction": {
            "default": "asc",
            "enum": [
              "asc",
              "desc"
            ],
            "title": "Direction",
            "type": "string"
          }
        },
        "required": [
          "field"
        ],
        "title": "SortSpec",
        "type": "object"
      },
      "WidgetSpec": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "title": "Id",
            "type": "string"
          },
          "title": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "chart": {
            "enum": [
              "card",
              "line",
              "bar",
              "horizontal_bar",
              "pie",
              "donut",
              "table"
            ],
            "title": "Chart",
            "type": "string"
          },
          "query_id": {
            "title": "Query Id",
            "type": "string"
          },
          "kpi": {
            "enum": [
              "sales_value",
              "transaction_count",
              "average_sale_value",
              "sold_property_count"
            ],
            "title": "Kpi",
            "type": "string"
          },
          "dimension": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Dimension"
          }
        },
        "required": [
          "id",
          "title",
          "chart",
          "query_id",
          "kpi"
        ],
        "title": "WidgetSpec",
        "type": "object"
      }
    }
  }
}
